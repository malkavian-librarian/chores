# Copy to .env for local development. Never commit the real .env file.

# Postgres connection string, e.g. postgres://user:password@localhost:5432/chores
# Leave unset in local dev to fall back to SQLite (see arch.md §1).
# On Railway, this is auto-injected by the attached Postgres plugin —
# do not set it manually in the Railway dashboard.
DATABASE_URL=

# Django secret key. Generate a real one for any non-local environment,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme

# Enable Django's debug mode. Never true in production.
DEBUG=True

# Comma-separated list of allowed hostnames, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to load (config.settings.dev or config.settings.prod).
# Railway must set this to config.settings.prod for the deployed service.
DJANGO_SETTINGS_MODULE=config.settings.dev
